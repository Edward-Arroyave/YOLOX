# Copiar este archivo como .env en la raíz del repositorio.
# Las rutas de imágenes son relativas a YOLOX_DATA_DIR.

YOLOX_DATA_DIR=/mnt/datasets/cassettes

YOLOX_TRAIN_IMAGES=images/train
YOLOX_VAL_IMAGES=images/val
YOLOX_TEST_IMAGES=images/test

YOLOX_ANNOTATIONS_DIR=labels/coco
YOLOX_TRAIN_ANN=train.json
YOLOX_VAL_ANN=val.json
YOLOX_TEST_ANN=test.json

# Ingesta desde Azure Blob Storage.
# No guardar la cadena real en Git; el archivo .env está ignorado.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=replace-me;AccountKey=replace-me;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=datasets

# Prefijo opcional anterior a la carpeta indicada en --folder.
AZURE_BLOB_BASE_PREFIX=

# Carpeta local donde se crearán los datasets descargados.
AZURE_INGEST_DESTINATION=datasets

# Copiar este archivo como .env en la raíz del repositorio.
# Las rutas de imágenes son relativas a YOLOX_DATA_DIR.

YOLOX_DATA_DIR=datasets/8-2026

YOLOX_TRAIN_IMAGES=training/images
YOLOX_VAL_IMAGES=val/images
# Mientras no exista un conjunto de prueba independiente, se reutiliza val.
YOLOX_TEST_IMAGES=val/images

YOLOX_ANNOTATIONS_DIR=.
YOLOX_TRAIN_ANN=training/annotations/annotations.json
YOLOX_VAL_ANN=val/annotations/annotations.json
YOLOX_TEST_ANN=val/annotations/annotations.json

# Ingesta desde Azure Blob Storage.
# No guardar la cadena real en Git; el archivo .env está ignorado.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=poctvet;AccountKey=REPLACE_WITH_POCTVET_ACCOUNT_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=rapitestlis

# Prefijo opcional anterior a la carpeta indicada en --folder.
AZURE_BLOB_BASE_PREFIX=training_yolox

# Carpeta local donde se crearán los datasets descargados.
AZURE_INGEST_DESTINATION=datasets

# Destino de los pesos versionados dentro del mismo contenedor de Azure.
AZURE_WEIGHTS_PREFIX=weights

# Pipeline general. La versión y el proyecto se pasan en el comando.
PIPELINE_OUTPUT_DIR=YOLOX_outputs
PIPELINE_ARTIFACTS_DIR=.pipeline_artifacts
PIPELINE_DEVICES=1
PIPELINE_BATCH_SIZE=8
PIPELINE_FP16=true
PIPELINE_ONNX_DYNAMIC=false
PIPELINE_ONNX_NO_SIMPLIFY=false
# Argumentos adicionales opcionales para tools/train.py.
PIPELINE_TRAIN_ARGS=

# # Perfil veterinaria: --project vet_yolox
# VET_YOLOX_DATASET_FOLDER=8-2026
# VET_YOLOX_BLOB_BASE_PREFIX=training_yolox
# VET_YOLOX_WEIGHTS_PREFIX=weights
# VET_YOLOX_EXP_FILE=exps/vet/vet_yolox.py
# VET_YOLOX_DATA_DIR=datasets/8-2026
# VET_YOLOX_TRAIN_IMAGES=training/images
# VET_YOLOX_VAL_IMAGES=val/images
# VET_YOLOX_TEST_IMAGES=val/images
# VET_YOLOX_ANNOTATIONS_DIR=.
# VET_YOLOX_TRAIN_ANN=training/annotations/annotations.json
# VET_YOLOX_VAL_ANN=val/annotations/annotations.json
# VET_YOLOX_TEST_ANN=val/annotations/annotations.json

# Perfil LIS: --project lis_yolox. Reemplazar el lote y las rutas si difieren.
LIS_YOLOX_DATASET_FOLDER=REPLACE_WITH_LIS_DATASET_FOLDER
LIS_YOLOX_BLOB_BASE_PREFIX=training_yolox
LIS_YOLOX_WEIGHTS_PREFIX=REPLACE_WITH_LIS_WEIGHTS_PREFIX
LIS_YOLOX_EXP_FILE=exps/vet/vet_yolox.py
LIS_YOLOX_DATA_DIR=datasets/REPLACE_WITH_LIS_DATASET_FOLDER
LIS_YOLOX_TRAIN_IMAGES=training/images
LIS_YOLOX_VAL_IMAGES=val/images
LIS_YOLOX_TEST_IMAGES=val/images
LIS_YOLOX_ANNOTATIONS_DIR=.
LIS_YOLOX_TRAIN_ANN=training/annotations/annotations.json
LIS_YOLOX_VAL_ANN=val/annotations/annotations.json
LIS_YOLOX_TEST_ANN=val/annotations/annotations.json

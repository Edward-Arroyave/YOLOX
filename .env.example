# Copiar como .env en la raíz del repositorio. No guardar credenciales reales en Git.

# Raíz usada al ejecutar tools/train.py manualmente; el pipeline usa la del perfil.
YOLOX_DATA_DIR=datasets/8-2026

# Cadena completa de acceso a la cuenta de Azure Storage.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=poctvet;AccountKey=REPLACE_WITH_POCTVET_ACCOUNT_KEY;EndpointSuffix=core.windows.net

# Contenedor de Azure que almacena datasets y modelos.
AZURE_STORAGE_CONTAINER=rapitestlis

# Prefijo remoto usado por el comando individual ingest_blob_storage.py.
AZURE_BLOB_BASE_PREFIX=training_yolox

# Directorio local donde se descargan los datasets.
AZURE_INGEST_DESTINATION=datasets

# Prefijo remoto usado por publish_weights.py cuando se ejecuta individualmente.
AZURE_WEIGHTS_PREFIX=weights

# Directorio local donde YOLOX guarda checkpoints, logs y TensorBoard.
PIPELINE_OUTPUT_DIR=YOLOX_outputs

# Directorio temporal para el último modelo base descargado desde Azure.
PIPELINE_ARTIFACTS_DIR=.pipeline_artifacts

# Cantidad de GPU que utilizará el entrenamiento.
PIPELINE_DEVICES=1

# Activa precisión mixta para reducir memoria y acelerar una GPU compatible.
PIPELINE_FP16=true

# Permite un tamaño de batch variable en el ONNX exportado.
PIPELINE_ONNX_DYNAMIC=false

# Evita la simplificación de ONNX cuando se establece en true.
PIPELINE_ONNX_NO_SIMPLIFY=false

# Argumentos adicionales opcionales enviados a tools/train.py.
# Para elegir pesos iniciales use --base-checkpoint en el pipeline, no --ckpt ni --resume aquí.
PIPELINE_TRAIN_ARGS=

# Zona horaria usada para calcular automáticamente el lote mensual M-YYYY.
PIPELINE_TIMEZONE=America/Bogota

# Ruta remota anterior al lote, compartida por vet y lis.
PIPELINE_BLOB_BASE_PREFIX=training_yolox

# Carpeta remota que contiene las versiones (1.0.0, 1.0.1...).
PIPELINE_WEIGHTS_PREFIX=weights

# Experimento único de cassettes usado tanto por vet como por lis.
PIPELINE_EXP_FILE=exps/cassette/cassette_yolox.py

# Credenciales de la aplicación externa de Gestión Documental.
DOCUMENT_API_CLIENT_ID=
DOCUMENT_API_CLIENT_SECRET=
DOCUMENT_API_BASE_URL=https://monitor-backend-annar-dev-evhaehfub5a8g4d3.eastus2-01.azurewebsites.net

# Vision Label Studio: agente que lanza este pipeline desde la app web
# (pipeline/agent/README.md). Reutiliza AZURE_STORAGE_CONNECTION_STRING.
# Contenedor y carpeta de las solicitudes; deben coincidir con
# TRAINING_BLOB_CONTAINER y TRAINING_RUNS_PREFIX de la app.
VLS_RUNS_CONTAINER=yolox
VLS_RUNS_PREFIX=vls-runs
# Cada cuántos segundos busca solicitudes y cada cuántos sube log y progreso.
VLS_POLL_SECONDS=20
VLS_LOG_UPLOAD_SECONDS=30

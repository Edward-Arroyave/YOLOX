{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ithealth.co/schemas/cassette-batch-manifest.schema.json",
  "title": "Cassette MLOps batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "period_start",
    "period_end",
    "created_at",
    "status",
    "source",
    "objects"
  ],
  "properties": {
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4}-[0-9]{2}(-[a-z0-9-]+)?$"},
    "period_start": {"type": "string", "format": "date-time"},
    "period_end": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "TRANSFERRING",
        "TRANSFERRED",
        "PRELABELING",
        "REVIEW_PENDING",
        "REVIEW_APPROVED",
        "DATASET_READY",
        "TRAINING",
        "EVALUATING",
        "CANDIDATE_READY",
        "PROMOTION_PENDING",
        "PROMOTED",
        "SKIPPED_NO_DATA",
        "FAILED"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_account", "container", "prefix"],
      "properties": {
        "storage_account": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "prefix": {"type": "string"}
      }
    },
    "transfer_job_id": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "failed_step": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0, "default": 0},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blob_name", "etag", "size"],
        "properties": {
          "blob_name": {"type": "string", "minLength": 1},
          "etag": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "checksum": {"type": ["string", "null"]}
        }
      }
    }
  }
}

# Non-secret Azure dataset configuration.
AZURE_STORAGE_ACCOUNT_URL=https://replace-me.blob.core.windows.net
AZURE_STORAGE_CONTAINER=cassette-images
AZURE_STORAGE_PREFIX=processed

# UTC interval is start-inclusive and end-exclusive: [start, end).
AZURE_DATA_START=2026-07-01T00:00:00Z
AZURE_DATA_END=2026-08-01T00:00:00Z

# Paths inside AZURE_STORAGE_PREFIX.
AZURE_TRAIN_IMAGE_DIR=train
AZURE_VAL_IMAGE_DIR=val
AZURE_TRAIN_ANNOTATION_BLOB=annotations/train.json
AZURE_VAL_ANNOTATION_BLOB=annotations/val.json

# Optional fixed test split. Leave both unset if Azure only contains train/val.
# AZURE_TEST_IMAGE_DIR=test
# AZURE_TEST_ANNOTATION_BLOB=annotations/test.json

# Local SSD destination on the GCP VM.
AZURE_DATASET_DIR=/mnt/cassette-mlops/datasets/monthly

# Authentication with a Microsoft Entra service principal.
# Set real values in the VM environment or Secret Manager, never in this file.
AZURE_TENANT_ID=replace-me
AZURE_CLIENT_ID=replace-me
AZURE_CLIENT_SECRET=replace-me
